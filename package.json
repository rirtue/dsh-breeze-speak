{
  "name": "dsh-breeze-speak",
  "version": "0.1.0",
  "description": "最小可用的 DSH 插件示例：读取本轮回复内容，用 BreezeBlue / Breeze TTS 2 念出来。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.2",
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ],
      "external": [
        "react"
      ]
    }
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "breeze",
    "tts"
  ],
  "license": "MIT"
}
