{
  "name": "dsh-breeze-speak",
  "version": "1.0.1",
  "description": "Reads each reply aloud with BreezeBlue / Breeze TTS 2: streams raw PCM over the /stream endpoint and plays it with Web Audio, so the first sentence starts ~0.6s after it appears. Settings page for API key and 15k+ online voices.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.2",
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ],
      "external": [
        "react"
      ]
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "breeze",
    "breezeblue",
    "tts",
    "text-to-speech",
    "voice",
    "speech",
    "pcm",
    "web-audio"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rirtue/dsh-breeze-speak.git"
  },
  "homepage": "https://github.com/rirtue/dsh-breeze-speak#readme",
  "bugs": {
    "url": "https://github.com/rirtue/dsh-breeze-speak/issues"
  },
  "author": "rirtue",
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  }
}
